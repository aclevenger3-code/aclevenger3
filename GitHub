> simulate_paths <- function(
+     v,
+     n_paths,
+     n_steps,
+     dt,
+     noise_sd,
+     start,
+     boundary
+ ) {
+ 
+   out <- vector("list", n_paths)
+ 
+   for (i in seq_len(n_paths)) {
+ 
+     # Evidence increments:
+     # drift component + random noise.
+     increments <- (
+       v * dt +
+         rnorm(
+           n_steps,
+           mean = 0,
+           sd = noise_sd * sqrt(dt)
+         )
+     )
+ 
+     # Accumulated evidence over time.
+     evidence <- start + cumsum(increments)
+ 
+     # Identify the first boundary crossing.
+     hit <- which(
+       evidence >= boundary |
+         evidence <= -boundary
+     )
+ 
+     # Stop accumulating evidence after a boundary is reached.
+     if (length(hit) > 0) {
+ 
+       first_hit <- hit[1]
+ 
+       # Clip the crossing value to the boundary.
+       evidence[first_hit] <- max(
+         min(evidence[first_hit], boundary),
+         -boundary
+       )
+ 
+       # Set subsequent evidence values to NA so the path ends.
+       if (first_hit < n_steps) {
+         evidence[(first_hit + 1):n_steps] <- NA_real_
+       }
+     }
+ 
+     out[[i]] <- data.frame(
+       path = i,
+       step = seq_len(n_steps),
+       time = seq_len(n_steps) * dt,
+       evidence = evidence
+     )
+   }
+ 
+   do.call(rbind, out)
+ }
